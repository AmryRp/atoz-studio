{
  "name": "atoz-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/prepare-assets.js && bun --bun vite --host 127.0.0.1",
    "start": "bun scripts/prepare-assets.js && bun --bun vite --host 127.0.0.1",
    "build": "bun scripts/prepare-assets.js && bun --bun vite build",
    "preview": "bun --bun vite preview --host 127.0.0.1",
    "check": "bun --bun svelte-check --tsconfig ./jsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "svelte": "5.57.1",
    "three": "0.186.1",
    "@vercel/blob": "2.8.0",
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "vite": "8.3.1",
    "svelte-check": "^4.4.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=20.0.0"
  }
}